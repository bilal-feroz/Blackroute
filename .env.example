# Copy this file to .env and fill in what you have.
# Keys are only read by the server functions in /api. They never reach the browser.

# Any one of these turns the AI agents on. With none, BlackRoute runs in
# offline mode: the simulator still does all the maths and the agents
# write their reports from templates.

# Google Gemini (free tier: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or any OpenAI-compatible endpoint (Groq, OpenRouter, OpenAI...)
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
